<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="78dp" android:gravity="center_vertical" android:background="@drawable/surface_panel"
    android:orientation="horizontal" android:padding="16dp">
    <ImageView android:id="@+id/AppIcon"
        android:layout_width="40dp" android:layout_height="40dp"
        android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="14dp"
        android:orientation="vertical">
        <TextView android:id="@+id/AppName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textSize="16sp"
            android:ellipsize="end" android:maxLines="1" />
        <TextView android:id="@+id/AppPackage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/muted"
            android:textSize="12sp" android:ellipsize="middle" android:maxLines="1" />
        <TextView android:id="@+id/AppFormat"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
    <ImageView android:layout_width="10dp" android:layout_height="15dp"
        android:layout_marginStart="10dp" android:contentDescription="@null"
        android:src="@drawable/ic_chevron" />
</LinearLayout>
